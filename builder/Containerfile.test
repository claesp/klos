# The KLOS test image: the builder, swtpm (a software TPM for QEMU) and the
# QEMU virtio GPU device (for the desktop test).
# /etc/klos-builder.lock is not changed, so the package input hashes are
# the same as in the builder.
ARG BUILDER
FROM ${BUILDER}
RUN apk add --no-cache swtpm qemu-system-x86_64 qemu-hw-display-virtio-gpu \
	qemu-hw-display-virtio-gpu-pci
