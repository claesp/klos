# The Arch Linux bootstrap builder. "klos bootstrap arch" verifies the
# bootstrap tarball (SHA-256 and OpenPGP signature) and removes its top
# directory (root.x86_64) before this build runs. pacman verifies each
# package with the keys of the archlinux-keyring package.
FROM scratch
ADD archlinux-bootstrap.tar /
ARG ARCH_DATE
COPY packages-arch.txt /tmp/packages.txt
RUN printf 'Server = https://archive.archlinux.org/repos/%s/$repo/os/$arch\n' "$ARCH_DATE" \
        > /etc/pacman.d/mirrorlist \
 && sed -i 's/^\[options\]$/[options]\nDisableSandbox/' /etc/pacman.conf \
 && pacman-key --init && pacman-key --populate archlinux \
 && pacman -Syu --noconfirm --needed $(grep -v '^#' /tmp/packages.txt) \
 && pacman -Q | sort > /etc/klos-builder.lock \
 && pacman -Scc --noconfirm && rm /tmp/packages.txt
COPY klos-builder-arch.conf /etc/klos-builder.conf
ENV LANG=C.UTF-8 LC_ALL=C.UTF-8 TZ=UTC
WORKDIR /klos
