# kubelet. Before "kubeadm init" or "kubeadm join", the configuration does
# not exist and kubelet stops. dinit starts it again every 10 seconds.
# "klos run-env" puts the words of the variables in the env file (or in
# /etc/default/kubelet) in place of the @NAME@ arguments.
type = process
command = /usr/bin/klos run-env /var/lib/kubelet/kubeadm-flags.env /etc/default/kubelet -- /usr/bin/kubelet --config=/var/lib/kubelet/config.yaml --kubeconfig=/etc/kubernetes/kubelet.conf --bootstrap-kubeconfig=/etc/kubernetes/bootstrap-kubelet.conf @KUBELET_KUBEADM_ARGS@ @KUBELET_EXTRA_ARGS@
depends-on = containerd
restart = true
restart-delay = 10
restart-limit-count = 0
log-type = file
logfile = /var/log/kubelet.log
