#!/bin/sh
# klos - host entry point for the KLOS build system.
#
# The host needs only Podman and sha256sum. All work runs in the KLOS
# builder: a container image that KLOS built itself (read
# docs/build-system.md). builder/seed.conf has the SHA-256 value of the
# builder image (the seed).
set -eu

TOP=$(cd "$(dirname "$0")" && pwd)
. "$TOP/builder/seed.conf"
SEED_TAR="$TOP/cache/builder/klos-builder-$(echo "$SEED_SHA256" | cut -c1-16).tar"
# KLOS_BUILDER names the output directories (out/<name>, work/<name>).
# KLOS_IMAGE selects a different builder image (for example to make a new
# seed from an old builder).
BUILDER=${KLOS_BUILDER:-klos}
IMAGE=${KLOS_IMAGE:-localhost/klos-builder:$(echo "$SEED_SHA256" | cut -c1-16)}

die() { echo "klos: $*" >&2; exit 1; }

usage() {
	cat <<USAGE
Usage: ./klos <command> [arguments]

Host commands:
  bootstrap            Check the seed (the builder image tarball) and import it.
  builder [-update]    Build the KLOS builder again in the KLOS builder and
                       compare it with the seed. -update makes the new
                       builder the seed.
  shell                Open a shell in the builder (no network).
  check                Run gofmt, go vet and the Go unit tests.
  keygen               Make a development key pair for update bundles.

Build commands (run in the builder):
  fetch <target>...    Download and verify sources (uses the network).
  check-sources        Check the SHA-256 value and signature of all sources.
  build <pkg>...       Build packages and their dependencies.
  image <flavor>       Build the OS image, kernel and update bundle.
  installer <flavor>   Build a bootable installer disk image.
  lock <flavor>        Write manifests/<flavor>.lock from current outputs.
  verify <flavor>      Build again and compare with the lock file.
  test <flavor>        Install the flavor in QEMU and run the boot tests.
  qemu <flavor>        Boot an installed test disk in QEMU (interactive).
  list                 Show all recipes.
  revoke <klos.efi>... Make a signed dbx update that revokes EFI binaries.
  selinux <flavor>     Compile the SELinux policy of a flavor (for development).
  compare -a A -b B <flavor>
                       Compare the builds of two builders (out/A and out/B).

Read docs/building.md for more information.
USAGE
}

# import_image <tar> <image>: make a container image from a builder tarball.
import_image() {
	podman import --change 'ENV PATH=/usr/bin:/opt/klos/go/bin' --change 'ENV LANG=C.UTF-8' \
		--change 'ENV LC_ALL=C.UTF-8' --change 'ENV TZ=UTC' --change 'WORKDIR /klos' \
		"$1" "$2" >/dev/null
}

cmd_bootstrap() {
	[ -f "$SEED_TAR" ] || die "no seed $SEED_TAR (copy it from a KLOS release or from a computer that has it)"
	echo "$SEED_SHA256  $SEED_TAR" | sha256sum -c - >/dev/null || die "SHA-256 mismatch for $SEED_TAR"
	import_image "$SEED_TAR" "$IMAGE"
	echo "klos: builder image $IMAGE is ready (the seed, SHA-256 checked)"
}

# cmd_builder [-update]: KLOS builds its builder.
cmd_builder() {
	update=no
	case ${1:-} in -update) update=yes ;; "") ;; *) die "usage: builder [-update]" ;; esac
	(kbuild yes no fetch builder)
	(kbuild no no builder-image)
	tar="$TOP/out/$BUILDER/builder/klos-builder.tar"
	sha=$(sha256sum "$tar" | cut -c1-64)
	if [ "$sha" = "$SEED_SHA256" ]; then
		echo "klos: the builder builds itself: the new builder is the same as the seed ($sha)"
	else
		echo "klos: the new builder is not the same as the seed"
		echo "klos:   seed $SEED_SHA256"
		echo "klos:   new  $sha"
	fi
	if [ "$update" = yes ]; then
		mkdir -p "$TOP/cache/builder"
		new="$TOP/cache/builder/klos-builder-$(echo "$sha" | cut -c1-16).tar"
		cp "$tar" "$new"
		printf '# The seed: the KLOS builder image (a tarball) that KLOS built itself.\n# "./klos builder -update" writes this file. Read docs/build-system.md.\nSEED_SHA256=%s\n' \
			"$sha" > "$TOP/builder/seed.conf"
		import_image "$new" "localhost/klos-builder:$(echo "$sha" | cut -c1-16)"
		echo "klos: the new builder is the seed ($new)"
	fi
}

# run_builder <network: yes|no> <kvm: yes|no> <command...>
run_builder() {
	net=$1; kvm=$2; shift 2
	podman image exists "$IMAGE" || die "no image $IMAGE; run './klos bootstrap'"
	# The work directory is always /build in the container, because some
	# programs keep the build paths in their output.
	mkdir -p "$TOP/work/$BUILDER"
	set -- --rm --init -v "$TOP:/klos:Z" -v "$TOP/work/$BUILDER:/build:Z" -w /klos \
		--hostname klos -e KLOS_WORK=/build \
		-e KLOS_JOBS="${KLOS_JOBS:-$(nproc)}" -e KLOS_BUILDER="$BUILDER" "$IMAGE" "$@"
	for v in KLOS_VERSION KLOS_RESUME KLOS_TEST_VERBOSE SOURCE_DATE_EPOCH; do
		eval "val=\${$v:-}"
		[ -n "$val" ] && set -- -e "$v=$val" "$@"
	done
	[ "$net" = no ] && set -- --network=none "$@"
	[ "$kvm" = yes ] && [ -e /dev/kvm ] && set -- --device /dev/kvm "$@"
	[ -t 0 ] && set -- -it "$@"
	exec podman run "$@"
}

# kbuild is compiled from tools/kbuild on each run (the Go cache makes this fast).
KBUILD_SH='cd /klos/tools/kbuild && GOCACHE=/klos/work/gocache GOFLAGS=-mod=vendor \
	GOTOOLCHAIN=local go build -trimpath -o /klos/work/bin/kbuild-$KLOS_BUILDER . && \
	exec /klos/work/bin/kbuild-$KLOS_BUILDER "$@"'

# The Go checks of "./klos check": gofmt, go vet and the unit tests.
CHECK_SH='set -e
export GOCACHE=/klos/work/gocache GOFLAGS=-mod=vendor GOTOOLCHAIN=local CGO_ENABLED=0
cmp -s tools/kbuild/selabel.go src/klos/selabel.go || { echo "klos check: tools/kbuild/selabel.go and src/klos/selabel.go are not the same"; exit 1; }
for m in tools/kbuild src/klos; do
	cd /klos/$m
	bad=$(gofmt -l $(ls *.go))
	[ -z "$bad" ] || { echo "klos check: gofmt: $m: $bad"; exit 1; }
	go vet ./...
	go test -count=1 ./...
done
echo "klos check: all Go checks passed"'

# kbuild <network: yes|no> <kvm: yes|no> <kbuild arguments...>
kbuild() {
	net=$1; kvm=$2; shift 2
	run_builder "$net" "$kvm" sh -c "$KBUILD_SH" kbuild "$@"
}

[ $# -ge 1 ] || { usage; exit 1; }
cmd=$1; shift
case $cmd in
	bootstrap) cmd_bootstrap ;;
	builder) cmd_builder "$@" ;;
	shell) run_builder no no bash -l ;;
	check) run_builder no no sh -c "$CHECK_SH" ;;
	keygen) kbuild no no keygen "$@" ;;
	fetch) kbuild yes no fetch "$@" ;;
	check-sources) kbuild yes no check-sources ;;
	build|image|installer|verify|selinux)
		# Download first with the network, then build without it.
		(kbuild yes no fetch "$@")
		kbuild no no "$cmd" "$@" ;;
	lock|list|revoke|compare) kbuild no no "$cmd" "$@" ;;
	test)
		(kbuild yes no fetch "$@")
		kbuild no yes test "$@" ;;
	qemu) kbuild no yes qemu "$@" ;;
	-h|--help|help) usage ;;
	*) usage; exit 1 ;;
esac
