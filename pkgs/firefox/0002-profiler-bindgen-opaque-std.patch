bindgen cannot compute the layout of some types of the libc++ 23 headers
("Not an item"). Mozilla builds with libstdc++. The profiler bindings
already make std::string, std::unique_ptr and std::vector opaque: make all
std types opaque.

--- a/tools/profiler/rust-api/build.rs
+++ b/tools/profiler/rust-api/build.rs
@@ -99,6 +99,7 @@
         // not an opaque type, bindgen can't find its size properly and
         // MarkerSchema's total size reduces. That causes a heap buffer overflow.
         .opaque_type("std::vector.*")
+        .opaque_type("std::.*")
         .raw_line("pub use self::root::*;")
         // Tell cargo to invalidate the built crate whenever any of the
         // included header files changed.
